# ==============================================================================
# pita - Environment Variables Template (.env.example)
# Copy this file to '.env' in the same directory and fill in your keys.
# ==============================================================================

# --- OpenAI API Configuration ---
# Required if using models like 'openai/gpt-4o' or 'openai/gpt-3.5-turbo'
OPENAI_API_KEY=sk-proj-exampleApiKey1234567890abcdefghijklmn

# --- Anthropic Claude Configuration ---
# Required if using models like 'anthropic/claude-3-5-sonnet-20241022'
ANTHROPIC_API_KEY=sk-ant-api03-exampleApiKey1234567890abcdefghijklmn

# --- Google Gemini Configuration ---
# Required if using Gemini models like 'gemini/gemini-1.5-pro'
GEMINI_API_KEY=AIzaSyExampleApiKey1234567890abcdef

# --- Groq Configuration ---
# Required if using models hosted on Groq, e.g. 'groq/llama3-8b-8192'
GROQ_API_KEY=gsk_exampleApiKey1234567890abcdef

# --- OpenRouter Configuration ---
# Required if routing through OpenRouter
OPENROUTER_API_KEY=sk-or-v1-exampleApiKey1234567890abcdef

# --- DeepSeek Configuration ---
# Required if using DeepSeek models like 'deepseek/deepseek-chat' or 'deepseek/deepseek-coder'
DEEPSEEK_API_KEY=sk-exampleApiKey1234567890abcdefdeepseek

# --- Local Ollama Configuration ---
# By default, Ollama runs on http://localhost:11434 and does not require an API key.
# If your Ollama instance is hosted on a custom network location, you can set it here:
# OLLAMA_API_BASE=http://127.0.0.1:11434

# --- Optional Agent Settings ---
# Customize the output directory for traces and screenshots (defaults to 'test_reports')
# PITA_REPORTS_DIR=my_custom_reports

# Disable LiteLLM's internal debugging telemetry output
# LITELLM_LOGGING=False
