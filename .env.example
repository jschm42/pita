# ==============================================================================
# pita - Environment Variables Template (.env.example)
# Copy this file to '.env' in the same directory and fill in your keys.
# ==============================================================================

# --- OpenAI API Configuration ---
# Required if using models like 'openai/gpt-4o' or 'openai/gpt-3.5-turbo'
OPENAI_API_KEY=sk-proj-exampleApiKey1234567890abcdefghijklmn

# --- Anthropic Claude Configuration ---
# Required if using models like 'anthropic/claude-3-5-sonnet-20241022'
ANTHROPIC_API_KEY=sk-ant-api03-exampleApiKey1234567890abcdefghijklmn

# --- Google Gemini Configuration ---
# Required if using Gemini models like 'gemini/gemini-1.5-pro'
GEMINI_API_KEY=AIzaSyExampleApiKey1234567890abcdef

# --- Groq Configuration ---
# Required if using models hosted on Groq, e.g. 'groq/llama3-8b-8192'
GROQ_API_KEY=gsk_exampleApiKey1234567890abcdef

# --- OpenRouter Configuration ---
# Required if routing through OpenRouter
OPENROUTER_API_KEY=sk-or-v1-exampleApiKey1234567890abcdef

# --- DeepSeek Configuration ---
# Required if using DeepSeek models. Remember to prefix model name with 'deepseek/',
# e.g., 'deepseek/deepseek-chat' or 'deepseek/deepseek-reasoner'.
DEEPSEEK_API_KEY=sk-exampleApiKey1234567890abcdefdeepseek
# Optional: custom base URL if using a DeepSeek API proxy or custom endpoint
# DEEPSEEK_API_BASE=https://api.deepseek.com

# --- Custom/Self-Hosted OpenAI Compatible Endpoints ---
# If you use a custom provider (e.g., LocalAI, vLLM, LM Studio) that matches the OpenAI API format:
# OPENAI_API_BASE=http://localhost:8000/v1
# OPENAI_API_KEY=not-needed-for-local

# --- Local Ollama Configuration ---
# By default, Ollama runs on http://localhost:11434 and does not require an API key.
# Use model format 'ollama/<model-name>' (e.g., 'ollama/llama3') in the project settings.
# If your Ollama instance is hosted on a custom network location, you can set it here:
# OLLAMA_API_BASE=http://127.0.0.1:11434

# --- Note on LiteLLM Model Name Prefix Requirement ---
# LiteLLM requires you to prefix the model name in your project configurations with the provider name
# so it knows where to route the request. Examples of correct configurations:
# - 'openai/gpt-4o'
# - 'anthropic/claude-3-5-sonnet-20241022'
# - 'gemini/gemini-1.5-pro'
# - 'deepseek/deepseek-chat'
# - 'ollama/llama3'
#
# Specifying a model name without the provider prefix (e.g., 'deepseek-v4-flash') will cause a BadRequestError.

# --- Optional Agent Settings ---
# Customize the output directory for traces and screenshots (defaults to 'test_reports')
# PITA_REPORTS_DIR=my_custom_reports

# Disable LiteLLM's internal debugging telemetry output
# LITELLM_LOGGING=False
